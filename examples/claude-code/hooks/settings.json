{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(pnpm test)",
      "Bash(pnpm lint)",
      "Bash(cargo test)",
      "Bash(cargo clippy)",
      "Bash(make test)",
      "Bash(make lint)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          "./scripts/check-protected-files.sh $CLAUDE_FILE_PATH"
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          "./scripts/auto-lint.sh $CLAUDE_FILE_PATH"
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          "./scripts/notify-done.sh"
        ]
      }
    ]
  }
}
